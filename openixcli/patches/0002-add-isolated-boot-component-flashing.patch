+/// Boot-storage component selected for an isolated boot-component flash.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum BootComponent {
+    /// The normal-mode U-Boot image written through the FES Boot1 channel.
+    Uboot,
+    /// The storage-specific Boot0 image.
+    Boot0,
+    /// The package-mode boot package written through the FES Boot1 channel.
+    BootPackage,
+}
+
+impl FromStr for BootComponent {
+    type Err = String;
+
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        match value {
+            "uboot" => Ok(Self::Uboot),
+            "boot0" => Ok(Self::Boot0),
+            "boot-package" => Ok(Self::BootPackage),
+            _ => Err(format!("Invalid boot component: {value}")),
+        }
+    }
+}
+
+impl fmt::Display for BootComponent {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Uboot => write!(f, "uboot"),
+            Self::Boot0 => write!(f, "boot0"),
+            Self::BootPackage => write!(f, "boot-package"),
+        }
+    }
+}
