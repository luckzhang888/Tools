+    /// Download only explicitly selected persistent boot components.
+    ///
+    /// This path does not download Preboot. The caller is responsible for
+    /// skipping erase, MBR, and normal partition stages.
+    pub async fn execute_selected<C: FesOps>(
+        &self,
+        ctx: &C,
+        packer: &mut OpenixPacker,
+        secure: u32,
+        storage_type: u32,
+        components: &[BootComponent],
+    ) -> FlashResult<()> {
+        self.validate_selected_components(secure, components)?;
+
+        self.logger.info(&format!(
+            "Downloading selected boot components: {}",
+            components
+                .iter()
+                .map(ToString::to_string)
+                .collect::<Vec<_>>()
+                .join(",")
+        ));
+
+        if components.contains(&BootComponent::Uboot)
+            || components.contains(&BootComponent::BootPackage)
+        {
+            self.download_boot1(ctx, packer, secure, storage_type)
+                .await?;
+        }
+        if components.contains(&BootComponent::Boot0) {
+            self.download_boot0(ctx, packer, secure, storage_type)
+                .await?;
+        }
+
+        self.logger
+            .stage_complete("Selected boot components downloaded");
+        Ok(())
+    }
+
+    fn validate_selected_components(
+        &self,
+        secure: u32,
+        components: &[BootComponent],
+    ) -> FlashResult<()> {
+        let incompatible = match secure {
+            BOOT_FILE_MODE_NORMAL => components.contains(&BootComponent::BootPackage),
+            BOOT_FILE_MODE_PKG => components.contains(&BootComponent::Uboot),
+            BOOT_FILE_MODE_TOC => {
+                components.contains(&BootComponent::Uboot)
+                    || components.contains(&BootComponent::BootPackage)
+            }
+            _ => {
+                return Err(FlashError::InvalidFirmwareFormat(format!(
+                    "unsupported target boot mode: {secure}"
+                )))
+            }
+        };
+
+        if incompatible {
+            return Err(FlashError::InvalidFirmwareFormat(format!(
+                "selected boot components are incompatible with target boot mode {}",
+                crate::config::boot_header::get_sunxi_boot_file_mode_string(secure)
+            )));
+        }
+
+        Ok(())
+    }
+
