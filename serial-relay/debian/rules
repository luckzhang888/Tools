#!/usr/bin/make -f
# Debian rules for serial-relay (Rust project)

%:
	dh $@

override_dh_auto_build:
	cargo build --release

override_dh_auto_test:
	@echo "Skipping tests (no serial hardware available in build env)"

override_dh_auto_install:
	install -D -m 755 target/release/serial debian/serial-relay/usr/bin/serial
